# Base URL of the Express REST API.
# The frontend talks ONLY to this API — never directly to Supabase.
# src/lib/config.ts defaults to https://api.ethioexchange.live/api/v1 when this
# is unset (so static deploys like Vercel need no VITE_ env var). Override it
# here for local development against a local backend.
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Optional: request timeout in milliseconds (defaults to 15000).
VITE_API_TIMEOUT_MS=15000

