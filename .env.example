# Base URL of the Express REST API.
# The frontend talks ONLY to this API — never directly to Supabase.
# Local dev: http://localhost:5000/api/v1
# Production: https://api.ethioexchange.live/api/v1
VITE_API_BASE_URL=https://api.ethioexchange.live/api/v1

# Optional: request timeout in milliseconds (defaults to 15000).
VITE_API_TIMEOUT_MS=15000

