# Base URL of the Express REST API.
# The frontend talks ONLY to this API — never directly to Supabase.
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Optional: request timeout in milliseconds (defaults to 15000).
VITE_API_TIMEOUT_MS=15000

# Mock data mode. While true (default), admin pages are powered by mock data
# from src/mocks/. Set to false only once the backend admin endpoints exist
# and are running — the hooks in src/hooks/use-admin.ts switch to the API.
VITE_USE_MOCKS=true
