# ── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── CORS ─────────────────────────────────────────────────
# Origin of the React frontend (dev server runs on 8080).
FRONTEND_URL=http://localhost:8080

# ── Supabase (NOT connected in Phase 1) ──────────────────
# REQUIRED at boot (no defaults) — replace with real credentials in Phase 2.
SUPABASE_URL=https://placeholder-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key

# ── JWT (used in later phases) ───────────────────────────
# REQUIRED at boot (no defaults) — replace with a long random string.
JWT_SECRET=development-secret-change-me
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# ── Logging ──────────────────────────────────────────────
# fatal | error | warn | info | http | debug
LOG_LEVEL=info
