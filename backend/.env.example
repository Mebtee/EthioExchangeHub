# ── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── CORS ─────────────────────────────────────────────────
# Origin of the React frontend (dev server runs on 8080).
# Legacy single-origin fallback — used when ALLOWED_ORIGINS is empty.
FRONTEND_URL=http://localhost:8080
# Comma-separated CORS allow-list. When empty, falls back to FRONTEND_URL.
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

# ── Supabase (Phase 2A: connected) ──────────────────────
# REQUIRED at boot (no defaults). The singleton client in src/lib/supabase.ts
# initializes from these, and GET /health verifies connectivity with them.
# Replace with real project credentials.
SUPABASE_URL=https://placeholder-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key

# ── JWT + admin bootstrap (Phase A1) ─────────────────────
# REQUIRED at boot (no defaults) — replace with a long random string.
# (run: openssl rand -base64 48)
JWT_SECRET=development-secret-change-me
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
# Lifetime of the short-lived password-reset token.
PASSWORD_RESET_TOKEN_EXPIRES_IN=30m

# The single bootstrap administrator, provisioned into the `users` table on
# FIRST login (only the scrypt hash is stored, never the plaintext). Change
# both in production; the placeholder email matches the frontend login hint.
ADMIN_EMAIL=admin@ethioexchange.dev
ADMIN_PASSWORD=change-me-to-a-long-secret

# ── Logging ──────────────────────────────────────────────
# fatal | error | warn | info | http | debug
LOG_LEVEL=info

# ── Security hardening (Phase 3A) ────────────────────────
# Trust the first proxy hop when behind nginx/load balancer (0 = off, 1 = one
# proxy, or "true"/"false"). Enables correct client IPs for rate limiting.
TRUST_PROXY=0

# General API rate limit: 100 requests / 15 minutes / IP (per window).
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
# Stricter limit for /docs and /metrics (default 30/15min/IP).
RATE_LIMIT_STRICT_MAX=30
# Brute-force protection for /auth (login/refresh/reset): 10 requests/15min/IP.
AUTH_RATE_LIMIT_MAX=10

# Slow-down: allow 50 requests/15min at full speed, then add a gradual delay
# (up to 2000 ms/request) instead of blocking.
SLOW_DOWN_WINDOW_MS=900000
SLOW_DOWN_DELAY_AFTER=50
SLOW_DOWN_MAX_DELAY_MS=2000

# Staleness window (days): a rate row older than this is served with
# `stale: true`. Stale rows are never dropped — views decide how to show them.
# 0 disables staleness marking.
# NOTE: "today" is the server's local date — run in Africa/Addis_Ababa (UTC+3)
# for correct local-calendar staleness.
MAX_RATE_AGE_DAYS=7

# Max JSON + URL-encoded request body size (oversized payloads → 413).
BODY_LIMIT=1mb
